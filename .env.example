# Copiar este archivo a .env y completar los valores. No subir .env al repositorio.
# Desarrollo con Docker: los valores por defecto del compose alcanzan;
# solo hace falta .env si querés cambiarlos o usar tu clave de Gemini.
# Producción: POSTGRES_PASSWORD y JWT_SECRET son OBLIGATORIOS y deben ser reales y distintos.

# Base de datos (el compose arma DATABASE_URL solo con estos tres)
POSTGRES_USER=spotter
POSTGRES_PASSWORD=cambiar-por-una-contrasena
POSTGRES_DB=spotter

# Fuera de Docker (backend corriendo directo en tu PC, base en el puerto 5434)
DATABASE_URL=postgresql://spotter:cambiar-por-una-contrasena@localhost:5434/spotter

JWT_SECRET=cambiar-por-un-valor-largo-y-aleatorio
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_DAILY_LIMIT=400
GEMINI_RPM_LIMIT=12
# Embeddings (RAG del catálogo). Límites de Google: 100 por minuto y 1.000 por día;
# se usa el 80 % como margen. Sin valores por defecto: si falta uno, no se llama.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_RPM_LIMIT=80
GEMINI_EMBEDDING_DAILY_LIMIT=800

# Correos: verificar el correo al registrarse y recuperar la contraseña (decisión 81).
# En desarrollo no hace falta nada: el compose manda los correos a Mailpit (http://localhost:8025).
# En producción son OBLIGATORIOS (sin ellos nadie puede registrarse). Con una cuenta de Gmail
# creada solo para Spotter: verificación en dos pasos + contraseña de aplicación (no tu contraseña).
# Cualquier otro servicio SMTP (Resend, Brevo...) funciona cambiando estos valores.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls          # starttls, ssl o none
# SMTP_USER=tu-cuenta-de-spotter@gmail.com
# SMTP_PASSWORD=la-contrasena-de-aplicacion
# SMTP_FROM=Spotter <tu-cuenta-de-spotter@gmail.com>
# APP_URL=https://la-direccion-publica-de-la-app    # los enlaces de los correos apuntan acá
# EMAIL_DAILY_LIMIT=50            # tope de correos por día (Gmail corta alrededor de 500)

# Solo producción (opcionales)
# NEXT_PUBLIC_API_URL=http://localhost:8000
# BACKEND_PORT=8000
# FRONTEND_PORT=3001

# Producción con HTTPS: poner true para que la cookie de sesión solo viaje cifrada.
COOKIE_SECURE=false
